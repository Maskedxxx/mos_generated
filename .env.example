# Переменные окружения сервиса генерации. Скопировать в .env (в корне), .env в git не попадает.
# Все необязательны — ниже значения по умолчанию.

# GEN_HOST=0.0.0.0            # адрес, на котором слушает uvicorn (scripts/restart.sh)
# GEN_PORT=8090               # порт сервиса
# GEN_TRACES_DIR=logs_generated       # журнал генераций: <тип>/session_<время>/ (meta.json, values.json, .docx)
# GEN_ORG_STORE=_org_store.json       # стор значений по организациям для автозаполнения (содержит ФИО — не в git)
# GEN_TRACES_MAX_GB=1         # лимит журнала в ГБ (0 — не удалять): при старте и раз в сутки удаляются самые старые session_* целиком
# LOG_DIR=/tmp                # куда пишется mosgen.log
